# Trading routines — Eastern time. Set the machine's timezone to
# America/New_York so these track market hours across DST automatically.
#
# Install with:  crontab local/crontab.et
#
# Each line runs Claude Code headless in the repo, feeding it the routine's
# prompt, and appends stdout+stderr to a per-routine log.
# The routines commit and push their own work; see local/README.md.

REPO=/home/user/claude-trading-tasks
LOGS=/home/user/claude-trading-tasks/local/logs
SHELL=/bin/bash

# Weekdays
# 7:00 AM  — overnight watch / pre-open brief
0 7 * * 1-5 cd $REPO && claude -p "$(cat local/prompts/0700_overnight.txt)" >> $LOGS/0700.log 2>&1

# 9:30 AM  — open reaction, stops and take-profits at the open print
30 9 * * 1-5 cd $REPO && claude -p "$(cat local/prompts/0930_open.txt)" >> $LOGS/0930.log 2>&1

# 10:00 AM — first trading session
0 10 * * 1-5 cd $REPO && claude -p "$(cat local/prompts/1000_trading.txt)" >> $LOGS/1000.log 2>&1

# 12:00 PM — midday trading; last stop check before 3:15
0 12 * * 1-5 cd $REPO && claude -p "$(cat local/prompts/1200_trading.txt)" >> $LOGS/1200.log 2>&1

# 3:15 PM  — close-out, overnight hold decisions, handoff for tomorrow
15 15 * * 1-5 cd $REPO && claude -p "$(cat local/prompts/1515_trading.txt)" >> $LOGS/1515.log 2>&1

# Saturday
# 10:00 AM — weekly performance review (was 14:00 UTC)
0 10 * * 6 cd $REPO && claude -p "$(cat local/prompts/weekly_review.txt)" >> $LOGS/weekly.log 2>&1
